class Solution {
    public int[] getSumAbsoluteDifferences(int[] nums) {
        int n = nums.length;
        int[] result = new int[n];

        // Calculate total sum of all elements
        long totalSum = 0;
        for (int num : nums) {
            totalSum += num;
        }

        long leftSum = 0;

        for (int i = 0; i < n; i++) {
            long current = nums[i];

      
            long leftCost = current * i - leftSum;

            long rightSum = totalSum - leftSum - current;
            long rightCount = n - i - 1;
            long rightCost = rightSum - current * rightCount;

            result[i] = (int) (leftCost + rightCost);

            leftSum += current;
        }

        return result;
    }
}
